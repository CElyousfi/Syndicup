{
  "name": "copropriete-maroc",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de gestion de copropriété — Maroc. Web + iOS + Android depuis une seule API.",
  "packageManager": "npm@9.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run generate --workspace=@copropriete-maroc/database",
    "db:migrate": "npm run migrate:dev --workspace=@copropriete-maroc/database",
    "db:seed": "npm run seed --workspace=@copropriete-maroc/database",
    "check:conformance": "node packages/api-contract/scripts/check-conformance.mjs"
  },
  "devDependencies": {
    "supabase": "^2.114.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
