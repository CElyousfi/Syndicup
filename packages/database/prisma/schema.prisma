  ARCHIVEE
}

enum StatutCompteUtilisateur {
  INVITE
  EN_VALIDATION
  ACTIF
  SUSPENDU
  DESACTIVE
  ANONYMISE
}

enum LanguePreferee {
  FR
  AR
}

enum CanalInvitation {
  EMAIL
  SMS
  QR_CODE
  WHATSAPP
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  EXPIREE
  REGENEREE
}

enum RoleType {
  SUPER_ADMIN
  SYNDIC
  CONSEIL_SYNDICAL
  PROPRIETAIRE
  LOCATAIRE
  INDIVISAIRE
  GARDIEN
  PRESTATAIRE
  PERSONNE_MORALE_REPRESENTANT
  // M15 (LCD) — ⚠️ valeur ABSENTE du Master Spec Partie 2.5 / Doc A, ajoutée et signalée (CLAUDE.md
  // §2) : gestionnaire de location courte durée (conciergerie, proche) désigné par le propriétaire,
  // scopé aux lots via lot_location_courte_duree.gestionnaire_id — jamais à toute la copropriété.
  GESTIONNAIRE_LCD
