// Schéma Prisma ACTIF — contient uniquement les modèles des modules déjà livrés (ROADMAP_BACKLOG).
// La cible complète (tous modules, traduction du Master Spec Partie 2) est conservée dans
// prisma/reference/schema-cible-complet.prisma : chaque module Mx déplace ses modèles ici,
// dans la même PR que sa migration — parce que les policies RLS doivent être écrites dans la
// MÊME migration que la création de table (CLAUDE.md §1.8, Master Spec Partie 2.3), et que les
// enums de modules futurs ne sont pas encore figés (Master Spec Partie 2.5).
//
// Décision UUID (note pré-M1 tranchée en M1) : UUID v7 généré côté application par le wrapper
// tenant (`apps/api/lib/tenant/`, package npm `uuidv7`) — meilleur pour l'index B-tree que v4.
// `gen_random_uuid()` reste le défaut DB (filet de sécurité si une écriture contourne le wrapper).
//
// RLS : Prisma ne génère pas les policies — elles sont en SQL brut dans les migrations, une par
// table, dans la migration qui crée la table. Voir prisma/migrations/*_m1_base/migration.sql.
//
// Money : tout champ Decimal est numeric(14,2) — jamais Float/Int pour un montant (CLAUDE.md §1.1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS — M1
// ============================================================================

enum TypeResidence {
  IMMEUBLE_COLLECTIF
  RESIDENCE_FERMEE
  RESIDENCE_VILLAS
  IMMEUBLE_BUREAUX
  IMMEUBLE_MIXTE
  RESIDENCE_ETUDIANTE
}

enum StatutCopropriete {
  ACTIVE
  ARCHIVEE
}

enum StatutCompteUtilisateur {
  INVITE
  EN_VALIDATION
  ACTIF
  SUSPENDU
  DESACTIVE
  ANONYMISE
}

enum LanguePreferee {
  FR
  AR
}

enum CanalInvitation {
  EMAIL
  SMS
  QR_CODE
  WHATSAPP
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  EXPIREE
  REGENEREE
}

enum RoleType {
  SUPER_ADMIN
  SYNDIC
  CONSEIL_SYNDICAL
  PROPRIETAIRE
  LOCATAIRE
  INDIVISAIRE
  GARDIEN
  PRESTATAIRE
  PERSONNE_MORALE_REPRESENTANT
}

// ============================================================================
// ENUMS — M3 (Master Spec Partie 2.2, Doc A §1, §2)
// ============================================================================

enum TypeLot {
  APPARTEMENT
  PARKING
  CAVE
  LOCAL
  TOIT_TERRASSE
  VILLA
  COMMERCIAL
  BUREAU
  LOGE_GARDIEN
}

// Liste de départ (Master Spec Partie 2.2). TANTIEME_A_REGULARISER : cas Doc A §3.1 (erreur
// notariale) — conservé comme statut de lot tel que noté dans le schéma de référence, à
// confirmer produit si un flag séparé serait préférable.
enum StatutLot {
  OCCUPE
  VACANT
  ORPHELIN
  EN_SUCCESSION
  SINISTRE
  TANTIEME_A_REGULARISER
}

// Doc A §1.1 : "Champ type_usage sur le lot : HABITATION / BUREAU / MIXTE / COMMERCIAL" — absent
// du tableau Master Spec Partie 2.2 mais explicitement demandé par Doc A (qui fait autorité sur
// le métier). Nullable : seul un sous-ensemble de lots (ex. appartement transformé en bureau) a
// besoin de cette distinction.
enum TypeUsageLot {
  HABITATION
  BUREAU
  MIXTE
  COMMERCIAL
}

enum TypePropriete {
  PLEIN
  INDIVISION
  SCI
}

enum TypeOccupation {
  PROPRIETAIRE_OCCUPANT
  LOCATAIRE
}

enum StatutSuccession {
  OUVERTE
  HERITIERS_DESIGNES
  CLOTUREE
}

// ============================================================================
// M1 — TENANT & UTILISATEURS (Master Spec Partie 2.2)
// ============================================================================

model Copropriete {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                   String
  adresse               String
  ville                 String
  typeResidence         TypeResidence     @map("type_residence")
  nbLots                Int               @map("nb_lots")
  dateCreation          DateTime          @default(now()) @map("date_creation") @db.Timestamptz
  statut                StatutCopropriete @default(ACTIVE)
  configJson            Json?             @map("config_json")
  // Paramètres légaux configurables — NE JAMAIS mettre de valeur par défaut ici avant
  // confirmation juridique (docs/LEGAL_QUESTIONS_BRIEF.md §1). Nullable tant que non confirmé.
  delaiConvocationJours Int?              @map("delai_convocation_jours")
  // Total des tantièmes défini au règlement de copropriété (ex. 1000, 10000) — champ absent du
  // tableau Master Spec Partie 2.2 mais nécessaire pour appliquer la contrainte Partie 2.4 "somme
  // des tantièmes d'une copropriété = total défini au règlement" (trigger M3, voir migration).
  // Nullable : saisi par le syndic à la configuration ; tant que non renseigné, le trigger de
  // blocage sur `lot` ne s'applique pas (pas une valeur légale au sens LEGAL_QUESTIONS_BRIEF.md,
  // simple donnée opérationnelle propre à chaque copropriété — pas de valeur par défaut devinée).
  totalTantiemes        Decimal?          @map("total_tantiemes") @db.Decimal(14, 2)
  // Surcharge des délais d'escalade impayés par défaut (Master Spec Partie 6.3 : "les délais
  // exacts doivent être calés sur la politique de recouvrement propre à chaque copropriété").
  // Nullable : les délais de Doc A §3.3 (voir apps/api/lib/finances/escalade.ts) s'appliquent
  // par défaut tant que non surchargé.
  politiqueRecouvrementJson Json?         @map("politique_recouvrement_json")
  // Paramètres légaux AG (M6, Master Spec Partie 8.3/8.5) — NE JAMAIS mettre de valeur par défaut
  // avant confirmation juridique (docs/LEGAL_QUESTIONS_BRIEF.md §2, §4). Nullable : tant que non
  // renseigné, `POST /ag/:id/ouvrir` et `POST /ag/:id/procurations` refusent explicitement (422)
  // plutôt que d'appliquer un chiffre deviné (ex. les "50%"/"3 procurations" trouvés en sources
  // secondaires dans le brief, PAS confirmés par un avocat).
  quorumPremiereConvocation      Decimal? @map("quorum_premiere_convocation") @db.Decimal(4, 3)
  limiteProcurationsMandataire   Int?     @map("limite_procurations_mandataire")
  // M13 — rétention avant anonymisation CNDP (Loi 09-08). LÉGALEMENT GATÉ
  // (LEGAL_QUESTIONS_BRIEF §5) : nullable sans défaut — le job d'anonymisation saute les
  // copropriétés non configurées, jamais de durée devinée.
  retentionDesactivationMois     Int?     @map("retention_desactivation_mois")
  creeLe                DateTime          @default(now()) @map("cree_le") @db.Timestamptz
  modifieLe             DateTime          @updatedAt @map("modifie_le") @db.Timestamptz

  rolesUtilisateur RoleUtilisateur[]
  invitations      Invitation[]
  lots             Lot[]
  espacesCommuns   EspaceCommun[]
  auditLogs        AuditLog[]
  budgetsAg        BudgetAg[]
  appelsDeFonds    AppelDeFonds[]
  fondsReserve     FondsReserve?
  prestataires     Prestataire[]
  incidents        Incident[]
  assembleesGenerales AssembleeGenerale[]
  documents        Document[]
  notifications    Notification[]
  personnel        Personnel[]
  visites          Visite[]
  litiges          ConflitLitige[]
  idempotencyKeys  IdempotencyKey[]
  sessionsCmi      PaiementCmiSession[]

  @@map("copropriete")
}

// Table globale (pas de copropriete_id — Master Spec Partie 1.6) : un utilisateur peut avoir des
// rôles dans plusieurs copropriétés. Sa visibilité est restreinte par policy RLS (voir migration).
model Utilisateur {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?                 @unique
  telephone      String?                 @unique
  nom            String?
  prenom         String?
  languePreferee LanguePreferee          @default(FR) @map("langue_preferee")
  statutCompte   StatutCompteUtilisateur @default(INVITE) @map("statut_compte")
  raisonSociale  String?                 @map("raison_sociale")
  rcNumero       String?                 @map("rc_numero")
  // M13 — CNDP (Loi 09-08) : point de départ de la rétention / horodatage d'anonymisation.
  desactiveLe    DateTime?               @map("desactive_le") @db.Timestamptz
  anonymiseLe    DateTime?               @map("anonymise_le") @db.Timestamptz
  creeLe         DateTime                @default(now()) @map("cree_le") @db.Timestamptz
  modifieLe      DateTime                @updatedAt @map("modifie_le") @db.Timestamptz

  roles             RoleUtilisateur[]
  invitationsEmises Invitation[]      @relation("InvitationEmetteur")
  lotsProprietaire  LotProprietaire[]
  lotsOccupant      LotOccupant[]
  auditLogsActeur   AuditLog[]
  incidentsCrees    Incident[]        @relation("IncidentCreateur")
  incidentLogsActeur IncidentLog[]    @relation("IncidentLogActeur")
  agVotes                  AgVote[]              @relation("AgVoteVotant")
  agProcurationsMandant    AgProcuration[]       @relation("AgProcurationMandant")
  agProcurationsMandataire AgProcuration[]       @relation("AgProcurationMandataire")
  agNotificationsRecues    AgNotificationLog[]   @relation("AgNotificationLogDestinataire")
  reservationsEspaceCommun ReservationEspaceCommun[]
  documentsCrees           Document[]
  notifications            Notification[]
  fichesPersonnel          Personnel[]
  visitesGardien           Visite[]              @relation("VisiteGardien")
  litigesCrees             ConflitLitige[]       @relation("LitigeCreateur")

  @@map("utilisateur")
}

model RoleUtilisateur {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  coproprieteId String      @map("copropriete_id") @db.Uuid
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  role          RoleType
  actif         Boolean     @default(true)
  creeLe        DateTime    @default(now()) @map("cree_le") @db.Timestamptz

  @@index([coproprieteId])
  @@index([utilisateurId])
  @@map("role_utilisateur")
  // Contrainte Master Spec 2.4 : un seul role='SYNDIC' actif=true par copropriété —
  // index unique partiel en SQL brut dans la migration M1 (non supporté par Prisma).
}

// ============================================================================
// M2 — ONBOARDING (Master Spec Partie 5.1, 5.3, 5.5)
// ============================================================================

model Invitation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId String           @map("copropriete_id") @db.Uuid
  copropriete   Copropriete      @relation(fields: [coproprieteId], references: [id])
  // Nullable : gardien/prestataire/syndic sont rattachés directement à la copropriété (Partie
  // 5.3). FK vers `lot` ajoutée ici (M3 — la table lot existe désormais, voir migration M3).
  lotId         String?          @map("lot_id") @db.Uuid
  lot           Lot?             @relation(fields: [lotId], references: [id])
  roleCible     RoleType         @map("role_cible")
  emetteurId    String           @map("emetteur_id") @db.Uuid
  emetteur      Utilisateur      @relation("InvitationEmetteur", fields: [emetteurId], references: [id])
  canal         CanalInvitation
  code          String           @unique
  statut        StatutInvitation @default(EN_ATTENTE)
  expireLe      DateTime         @map("expire_le") @db.Timestamptz
  creeLe        DateTime         @default(now()) @map("cree_le") @db.Timestamptz

  @@index([coproprieteId])
  @@map("invitation")
}

// ============================================================================
// M3 — LOTS, PROPRIÉTÉ, OCCUPATION (Master Spec Partie 2.2, Doc A §1, §2)
// ============================================================================

model Lot {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId String         @map("copropriete_id") @db.Uuid
  copropriete   Copropriete    @relation(fields: [coproprieteId], references: [id])
  typeLot       TypeLot        @map("type_lot")
  // Doc A §1.1 — voir commentaire de l'enum TypeUsageLot. Nullable, non renseigné par défaut.
  typeUsage     TypeUsageLot?  @map("type_usage")
  numero        String
  etage         Int?
  tantiemes     Decimal        @db.Decimal(14, 2)
  superficie    Decimal?       @db.Decimal(10, 2)
  statut        StatutLot      @default(VACANT)
  lotParentId   String?        @map("lot_parent_id") @db.Uuid
  lotParent     Lot?           @relation("LotParentEnfant", fields: [lotParentId], references: [id])
  lotsEnfants   Lot[]          @relation("LotParentEnfant")
  creeLe        DateTime       @default(now()) @map("cree_le") @db.Timestamptz
  modifieLe     DateTime       @updatedAt @map("modifie_le") @db.Timestamptz

  proprietaires    LotProprietaire[]
  occupants        LotOccupant[]
  successions      Succession[]
  invitations      Invitation[]
  appelsDeFondsLot AppelDeFondsLot[]
  paiements        Paiement[]
  incidents        Incident[]
  agVotes          AgVote[]
  agProcurations   AgProcuration[]
  reservations     ReservationEspaceCommun[]
  personnelLoges   Personnel[]
  visites          Visite[]

  @@index([coproprieteId])
  @@map("lot")
}

model EspaceCommun {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId         String   @map("copropriete_id") @db.Uuid
  copropriete           Copropriete @relation(fields: [coproprieteId], references: [id])
  nom                   String
  type                  String
  capacite              Int?
  reservable            Boolean  @default(false)
  reglesReservationJson Json?    @map("regles_reservation_json")
  // Doc A §7.2 : "Validation manuelle ou auto selon paramètre" — absent du tableau Master Spec
  // littéral (qui ne liste que espace_commun/reservation_espace_commun sans détail de workflow),
  // ajouté par nécessité pour distinguer les deux modes explicitement demandés par Doc A.
  validationAutomatique Boolean  @default(false) @map("validation_automatique")

  reservations ReservationEspaceCommun[]

  @@index([coproprieteId])
  @@map("espace_commun")
}

enum StatutReservationEspaceCommun {
  EN_ATTENTE
  CONFIRMEE
  REJETEE
  ANNULEE
}

// Doc A §7.2. utilisateur_id (auteur de la réservation) absent du tableau Master Spec littéral
// (id, espace_id, lot_id, date_debut, date_fin, statut) — ajouté par nécessité : Doc A parle
// systématiquement du "résident" qui réserve, pas seulement du lot, et l'auteur peut différer du
// propriétaire du lot (locataire réservant pour son lot, par exemple).
model ReservationEspaceCommun {
  id            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  espaceId      String                         @map("espace_id") @db.Uuid
  espace        EspaceCommun                   @relation(fields: [espaceId], references: [id])
  lotId         String                         @map("lot_id") @db.Uuid
  lot           Lot                            @relation(fields: [lotId], references: [id])
  utilisateurId String                         @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur                    @relation(fields: [utilisateurId], references: [id])
  dateDebut     DateTime                       @map("date_debut") @db.Timestamptz
  dateFin       DateTime                       @map("date_fin") @db.Timestamptz
  statut        StatutReservationEspaceCommun  @default(EN_ATTENTE)
  // Doc A §7.2 "Champ nombre_invites sur réservation" — extension explicitement nommée par Doc A.
  nombreInvites Int?                           @map("nombre_invites")
  motifRejet    String?                        @map("motif_rejet")
  creeLe        DateTime                       @default(now()) @map("cree_le") @db.Timestamptz
  modifieLe     DateTime                       @updatedAt @map("modifie_le") @db.Timestamptz

  @@index([espaceId])
  @@index([lotId])
  @@map("reservation_espace_commun")
}

// ============================================================================
// ENUMS — M9 (Master Spec Partie 7, 9)
// ============================================================================

// Master Spec Partie 9.4 : reprend directement Doc A §12.3.
enum VisibiliteDocument {
  PUBLIC_COPROPRIETE
  SYNDIC_ONLY
  CONSEIL_SYNDICAL
}

// Master Spec Partie 7.1 : canaux effectivement utilisés (email, SMS, push, WhatsApp phase 2) —
// distinct de CanalInvitation (M1/M2) qui inclut QR_CODE, non pertinent pour une notification.
enum CanalNotification {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum StatutEnvoiNotification {
  EN_ATTENTE
  ENVOYE
  ECHOUE
}

// ============================================================================
// M9 — NOTIFICATIONS & DOCUMENTS (Master Spec Partie 7, 9)
// ============================================================================

// Doc A §12.3 / Master Spec Partie 9.4. `cree_par` nullable : un document peut être généré par un
// job système (PV, quittance) sans acteur humain.
model Document {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId String             @map("copropriete_id") @db.Uuid
  copropriete   Copropriete        @relation(fields: [coproprieteId], references: [id])
  type          String
  nom           String
  visibilite    VisibiliteDocument
  // Chemin dans Supabase Storage (Master Spec Partie 9.3) — jamais une URL publique stockée ici,
  // l'URL signée à durée de vie courte est générée à la demande par l'API.
  storagePath   String             @map("storage_path")
  creePar       String?            @map("cree_par") @db.Uuid
  createur      Utilisateur?       @relation(fields: [creePar], references: [id])
  creeLe        DateTime           @default(now()) @map("cree_le") @db.Timestamptz

  @@index([coproprieteId])
  @@map("document")
}

// Append-only (Master Spec Partie 7.2 : "ligne notification immuable" — preuve légale d'envoi).
// coproprieteId absent du tableau Master Spec littéral (Partie 7.2 ne liste que
// canal/horodatage/statut_envoi/accuse_reception) — ajouté par nécessité, même logique que
// `audit_log.copropriete_id` en M4 : une policy RLS de tenant isolation est non négociable et il
// n'existe aucune autre colonne fixe pour la dériver.
// `lu`/`lu_le` absents du tableau littéral, ajoutés par nécessité pour `PATCH
// /notifications/:id/read` (Master Spec Partie 3.2) qui n'aurait sinon aucun état à modifier.
model Notification {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId   String                   @map("copropriete_id") @db.Uuid
  copropriete     Copropriete              @relation(fields: [coproprieteId], references: [id])
  utilisateurId   String                   @map("utilisateur_id") @db.Uuid
  utilisateur     Utilisateur              @relation(fields: [utilisateurId], references: [id])
  templateCode    String                   @map("template_code")
  canal           CanalNotification
  statutEnvoi     StatutEnvoiNotification  @default(EN_ATTENTE) @map("statut_envoi")
  contenuJson     Json?                    @map("contenu_json")
  accuseReception DateTime?                @map("accuse_reception") @db.Timestamptz
  lu              Boolean                  @default(false)
  luLe            DateTime?                @map("lu_le") @db.Timestamptz
  horodatageEnvoi DateTime                 @default(now()) @map("horodatage_envoi") @db.Timestamptz

  @@index([coproprieteId])
  @@index([utilisateurId])
  @@map("notification")
}

// ============================================================================
// M10 — PERSONNEL / GARDIEN (Master Spec Partie 2.2/13.3, Doc A §9)
// ============================================================================

enum StatutPersonnel {
  PRESENT
  ABSENT
  REMPLACE
}

enum StatutVisite {
  EN_ATTENTE
  AUTORISE
  REFUSE
}

// Le tableau Master Spec Partie 2.2 référence "Doc A §7" pour `visite`, mais §7
// (docs/domain-reference/07-parties-communes.md) ne couvre que les espaces communs — le seul
// document Doc A qui traite du contrôle d'accès visiteurs est §9.2
// (docs/domain-reference/09-personnel-gardien.md, ligne "Visiteurs et contrôle d'accès") : écart
// de renumérotation signalé (même famille de divergence que CategorieIncident/UrgenceIncident en
// M7), pas une invention — Doc A §9 fait donc autorité ici comme pour `personnel`.
model Personnel {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateurId String          @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur     @relation(fields: [utilisateurId], references: [id])
  coproprieteId String          @map("copropriete_id") @db.Uuid
  copropriete   Copropriete     @relation(fields: [coproprieteId], references: [id])
  statut        StatutPersonnel @default(PRESENT)
  // Doc A §9.2 "Logement attribué (lot type LOGE_GARDIEN)" — nullable : gardien non-résident.
  logementLotId String?         @map("logement_lot_id") @db.Uuid
  logementLot   Lot?            @relation(fields: [logementLotId], references: [id])
  creeLe        DateTime        @default(now()) @map("cree_le") @db.Timestamptz

  @@unique([utilisateurId, coproprieteId])
  @@index([coproprieteId])
  @@map("personnel")
}

// Doc A §9.2 "Module visites : Gardien enregistre → notification push au résident → Résident
// autorise ou refuse → Gardien reçoit la réponse". copropriete_id absent du tableau Master Spec
// littéral (id, gardien_id, lot_id, visiteur_nom, statut, horodatage) — ajouté par nécessité,
// même logique que les autres tables M4/M7/M9 (une policy RLS de tenant isolation directe est
// non négociable, CLAUDE.md §1.8).
model Visite {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId String       @map("copropriete_id") @db.Uuid
  copropriete   Copropriete  @relation(fields: [coproprieteId], references: [id])
  gardienId     String       @map("gardien_id") @db.Uuid
  gardien       Utilisateur  @relation("VisiteGardien", fields: [gardienId], references: [id])
  lotId         String       @map("lot_id") @db.Uuid
  lot           Lot          @relation(fields: [lotId], references: [id])
  visiteurNom   String       @map("visiteur_nom")
  statut        StatutVisite @default(EN_ATTENTE)
  horodatage    DateTime     @default(now()) @db.Timestamptz

  @@index([coproprieteId])
  @@index([lotId])
  @@map("visite")
}

// ============================================================================
// M11 — LITIGES (Master Spec Partie 2.2, Doc A §12.1)
// ============================================================================

enum StatutLitige {
  OUVERT
  RESOLU
  CLOS
}

// Colonnes du tableau Master Spec Partie 2.2 (id, copropriete_id, type, description, statut,
// escalade_niveau int). `type` reste un TEXT libre : Doc A §12.1 liste 8 familles de conflits
// mais sans nomenclature fermée — pas d'enum devinée. `escalade_niveau` suit le workflow Doc A
// §12.1 "Syndic répond → Si non résolu → Médiation AG → Tribunal" : 0 = traitement syndic,
// 1 = médiation AG, 2 = tribunal (monotone, jamais décrémenté — valeur probante).
// `cree_par` ajouté par nécessité (absent du tableau littéral) : porteur du litige, support de
// la policy RLS de confidentialité (un résident ne voit que SES litiges, Doc A §12.3).
// ⚠️ LEGAL_QUESTIONS_BRIEF.md §0 : une étape de conciliation préalable obligatoire (Loi 30-24)
// pourrait devoir s'insérer avant le niveau tribunal — non modélisée tant que non confirmée.
model ConflitLitige {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId  String       @map("copropriete_id") @db.Uuid
  copropriete    Copropriete  @relation(fields: [coproprieteId], references: [id])
  type           String
  description    String
  statut         StatutLitige @default(OUVERT)
  escaladeNiveau Int          @default(0) @map("escalade_niveau")
  creePar        String       @map("cree_par") @db.Uuid
  createur       Utilisateur  @relation("LitigeCreateur", fields: [creePar], references: [id])
  creeLe         DateTime     @default(now()) @map("cree_le") @db.Timestamptz
  modifieLe      DateTime     @updatedAt @map("modifie_le") @db.Timestamptz

  @@index([coproprieteId])
  @@map("conflit_litige")
}

// Contrainte Master Spec 2.4 : somme des quote_part actives (date_fin IS NULL) d'un même lot =
// 100% — appliquée par un contrainte trigger DEFERRABLE INITIALLY DEFERRED en SQL brut (voir
// migration M3), pas exprimable en Prisma. S'applique aussi bien au plein propriétaire unique
// (une seule ligne à 100%) qu'à l'indivision (Doc A §2.4).
model LotProprietaire {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId                      String        @map("lot_id") @db.Uuid
  lot                        Lot           @relation(fields: [lotId], references: [id])
  utilisateurId              String        @map("utilisateur_id") @db.Uuid
  utilisateur                Utilisateur   @relation(fields: [utilisateurId], references: [id])
  quotePart                  Decimal       @map("quote_part") @db.Decimal(5, 2)
  typePropriete              TypePropriete @map("type_propriete")
  estRepresentantIndivision  Boolean       @default(false) @map("est_representant_indivision")
  dateDebut                  DateTime      @map("date_debut") @db.Date
  dateFin                    DateTime?     @map("date_fin") @db.Date

  @@index([lotId])
  @@index([utilisateurId])
  @@map("lot_proprietaire")
}

model LotOccupant {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId                  String         @map("lot_id") @db.Uuid
  lot                    Lot            @relation(fields: [lotId], references: [id])
  utilisateurId          String         @map("utilisateur_id") @db.Uuid
  utilisateur            Utilisateur    @relation(fields: [utilisateurId], references: [id])
  typeOccupation         TypeOccupation @map("type_occupation")
  dateDebut              DateTime       @map("date_debut") @db.Date
  dateFin                DateTime?      @map("date_fin") @db.Date
  accesFinancesAccorde   Boolean        @default(false) @map("acces_finances_accorde")
  recoitConvocations     Boolean        @default(false) @map("recoit_convocations")

  @@index([lotId])
  @@index([utilisateurId])
  @@map("lot_occupant")
}

// Doc A §2.5 : ouverture d'une succession au décès d'un propriétaire. Le workflow complet
// (désignation des héritiers, clôture) est traité au fil de l'eau par le syndic — cette table
// couvre la structure de données minimale ; les endpoints dédiés (au-delà de la lecture via le
// lot) sont un TODO ROADMAP explicite, pas un oubli silencieux.
model Succession {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId                String           @map("lot_id") @db.Uuid
  lot                  Lot              @relation(fields: [lotId], references: [id])
  proprietaireDecedeId String           @map("proprietaire_decede_id") @db.Uuid
  statut               StatutSuccession @default(OUVERTE)
  contactTemporaireId  String?          @map("contact_temporaire_id") @db.Uuid
  dateOuverture        DateTime         @default(now()) @map("date_ouverture") @db.Timestamptz

  @@index([lotId])
  @@map("succession")
}

// ============================================================================
// M4 — AUDIT LOG (Master Spec Partie 2.2 "Documents, notifications, audit")
// ============================================================================

// Append-only strict (CLAUDE.md §1 non-négociable n°2) : pas de modifieLe, pas d'UPDATE/DELETE
// autorisé côté application_role (REVOKE en migration) — correction = nouvelle ligne.
// coproprieteId : absent de la table Master Spec Partie 2.2 littérale, ajouté ici (comme
// copropriete.totalTantiemes en M3) parce qu'une policy RLS de tenant isolation est non
// négociable (CLAUDE.md §1.8) et qu'il n'existe aucune autre colonne fixe pour la dériver — la
// jointure via entite/entite_id dépend du type d'entité et ne peut pas servir de policy générique.
model AuditLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coproprieteId String    @map("copropriete_id") @db.Uuid
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  // Nullable : action système (job Inngest) sans acteur humain (Master Spec Partie 2.2).
  acteurId      String?   @map("acteur_id") @db.Uuid
  acteur        Utilisateur? @relation(fields: [acteurId], references: [id])
  action        String
  entite        String
  entiteId      String    @map("entite_id") @db.Uuid
  avantJson     Json?     @map("avant_json")
  apresJson     Json?     @map("apres_json")
  horodatage    DateTime  @default(now()) @db.Timestamptz
  ip            String?

  @@index([coproprieteId])
  @@index([entite, entiteId])
  @@map("audit_log")
}

