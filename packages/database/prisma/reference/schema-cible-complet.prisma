/// APPEND-ONLY — preuve légale d'envoi (Master Spec Partie 7.2).
model AgNotificationLog {
  id              String    @id @default(uuid()) @db.Uuid
  agId            String    @map("ag_id") @db.Uuid
  assembleeGenerale AssembleeGenerale @relation(fields: [agId], references: [id])
  utilisateurId   String    @map("utilisateur_id") @db.Uuid
  canal           CanalNotification
  horodatageEnvoi DateTime  @default(now()) @map("horodatage_envoi") @db.Timestamptz
  accuseReception Boolean?  @map("accuse_reception")

  @@map("ag_notification_log")
  @@index([agId])
}

// ============================================================================
// INCIDENTS, PERSONNEL, TIERS
// ============================================================================

model Incident {
  id             String          @id @default(uuid()) @db.Uuid
  coproprieteId  String          @map("copropriete_id") @db.Uuid
  copropriete    Copropriete     @relation(fields: [coproprieteId], references: [id])
  lotId          String?         @map("lot_id") @db.Uuid // nullable si partie commune
  lot            Lot?            @relation(fields: [lotId], references: [id])
  categorie      String
  sousCategorie  String?         @map("sous_categorie")
  partie         PartieIncident
  urgence        UrgenceIncident @default(NORMALE)
  statut         StatutIncident  @default(OUVERT)
  creeParId      String          @map("cree_par") @db.Uuid
  creeParUtilisateur Utilisateur @relation("IncidentCreateur", fields: [creeParId], references: [id])
  assigneAId     String?         @map("assigne_a") @db.Uuid
  prestataire    Prestataire?    @relation(fields: [assigneAId], references: [id])
  slaDeadline    DateTime?       @map("sla_deadline") @db.Timestamptz
  creeLe         DateTime        @default(now()) @map("cree_le") @db.Timestamptz

  logs           IncidentLog[]

  @@map("incident")
  @@index([coproprieteId])
  @@index([lotId])
}

/// APPEND-ONLY.
model IncidentLog {
  id            String      @id @default(uuid()) @db.Uuid
  incidentId    String      @map("incident_id") @db.Uuid
  incident      Incident    @relation(fields: [incidentId], references: [id])
  statutAvant   StatutIncident @map("statut_avant")
  statutApres   StatutIncident @map("statut_apres")
  acteurId      String      @map("acteur_id") @db.Uuid
  commentaire   String?
  horodatage    DateTime    @default(now()) @db.Timestamptz

  @@map("incident_log")
  @@index([incidentId])
}

model Prestataire {
  id            String    @id @default(uuid()) @db.Uuid
  coproprieteId String    @map("copropriete_id") @db.Uuid
  copropriete   Copropriete @relation(fields: [coproprieteId], references: [id])
  nom           String
  specialite    String?
  contact       String?
  actif         Boolean   @default(true)

  incidentsAssignes Incident[]

  @@map("prestataire")
  @@index([coproprieteId])
}

model Personnel {
  utilisateurId  String           @id @map("utilisateur_id") @db.Uuid
  utilisateur    Utilisateur      @relation(fields: [utilisateurId], references: [id])
  coproprieteId  String           @map("copropriete_id") @db.Uuid
  copropriete    Copropriete      @relation(fields: [coproprieteId], references: [id])
  statut         StatutPersonnel  @default(PRESENT)
  logementLotId  String?          @map("logement_lot_id") @db.Uuid
  logementLot    Lot?             @relation("LogementGardien", fields: [logementLotId], references: [id])

  visitesEnregistrees Visite[]

  @@map("personnel")
  @@index([coproprieteId])
}

model Visite {
  id           String       @id @default(uuid()) @db.Uuid
  gardienId    String       @map("gardien_id") @db.Uuid
  gardien      Personnel    @relation(fields: [gardienId], references: [utilisateurId])
  lotId        String       @map("lot_id") @db.Uuid
  lot          Lot          @relation(fields: [lotId], references: [id])
  visiteurNom  String       @map("visiteur_nom")
  statut       StatutVisite @default(EN_ATTENTE)
  horodatage   DateTime     @default(now()) @db.Timestamptz

  @@map("visite")
  @@index([lotId])
  @@index([gardienId])
  // Table concernée par la sync offline (Master Spec Partie 13.3) — écriture optimiste côté
  // mobile, résolution "dernière écriture gagne" côté serveur. Ne PAS répliquer ce pattern sur
  // une table financière ou probante.
}

model ReservationEspaceCommun {
  id         String            @id @default(uuid()) @db.Uuid
  espaceId   String            @map("espace_id") @db.Uuid
  espace     EspaceCommun      @relation(fields: [espaceId], references: [id])
  lotId      String            @map("lot_id") @db.Uuid
  lot        Lot               @relation(fields: [lotId], references: [id])
  dateDebut  DateTime          @map("date_debut") @db.Timestamptz
  dateFin    DateTime          @map("date_fin") @db.Timestamptz
  statut     StatutReservation @default(CONFIRMEE)

  @@map("reservation_espace_commun")
  @@index([espaceId])
  @@index([lotId])
}

model ConflitLitige {
  id             String    @id @default(uuid()) @db.Uuid
  coproprieteId  String    @map("copropriete_id") @db.Uuid
  copropriete    Copropriete @relation(fields: [coproprieteId], references: [id])
  type           String
  description    String
  statut         String
  escaladeNiveau Int       @default(0) @map("escalade_niveau")
  creeLe         DateTime  @default(now()) @map("cree_le") @db.Timestamptz
  // Étape de conciliation préalable potentiellement requise par la Loi 30-24 —
  // voir docs/LEGAL_QUESTIONS_BRIEF.md §0. Champ à ajouter une fois confirmé, pas avant.

  @@map("conflit_litige")
  @@index([coproprieteId])
}

model GarantiePromoteur {
  id            String       @id @default(uuid()) @db.Uuid
  lotId         String?      @map("lot_id") @db.Uuid
  lot           Lot?         @relation(fields: [lotId], references: [id])
  coproprieteId String?      @map("copropriete_id") @db.Uuid
  type          TypeGarantie
  dateDebut     DateTime     @map("date_debut") @db.Date
  dateFin       DateTime     @map("date_fin") @db.Date

  @@map("garantie_promoteur")
}

// ============================================================================
// DOCUMENTS, NOTIFICATIONS, AUDIT
// ============================================================================

model Document {
  id            String             @id @default(uuid()) @db.Uuid
  coproprieteId String             @map("copropriete_id") @db.Uuid
  copropriete   Copropriete        @relation(fields: [coproprieteId], references: [id])
  type          TypeDocument
  url           String
  visibilite    VisibiliteDocument
  dateCreation  DateTime           @default(now()) @map("date_creation") @db.Timestamptz

  @@map("document")
  @@index([coproprieteId])
}

/// APPEND-ONLY — preuve légale, Doc A §12.2.
model Notification {
  id             String                  @id @default(uuid()) @db.Uuid
  utilisateurId  String                  @map("utilisateur_id") @db.Uuid
  utilisateur    Utilisateur             @relation(fields: [utilisateurId], references: [id])
  canal          CanalNotification
  templateCode   String                  @map("template_code")
  contenuRendu   String                  @map("contenu_rendu")
  statutEnvoi    StatutEnvoiNotification @default(EN_FILE) @map("statut_envoi")
  accuseReception Boolean                @default(false) @map("accuse_reception")
  horodatage     DateTime                @default(now()) @db.Timestamptz

  @@map("notification")
  @@index([utilisateurId])
}

/// APPEND-ONLY — jamais UPDATE/DELETE (Master Spec Partie 2.4).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  acteurId   String?     @map("acteur_id") @db.Uuid // nullable si système (ex. job Inngest)
  acteur     Utilisateur? @relation(fields: [acteurId], references: [id])
  action     String
  entite     String
  entiteId   String      @map("entite_id") @db.Uuid
  avantJson  Json?       @map("avant_json")
  apresJson  Json?       @map("apres_json")
  horodatage DateTime    @default(now()) @db.Timestamptz
  ip         String?

  @@map("audit_log")
  @@index([entite, entiteId])
  @@index([acteurId])
}
