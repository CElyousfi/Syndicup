<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
    
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/w_ic_building" android:contentDescription="@null"/>
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:singleLine="true" android:ellipsize="end" android:textColor="@color/w_soft" android:textSize="11sp" android:textStyle="bold" android:textAllCaps="true" android:letterSpacing="0.04"/>
        <ImageView android:id="@+id/w_eye" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp"
            android:src="@drawable/w_ic_eye" android:contentDescription="@string/w_toggle_amounts" android:background="@drawable/w_bg_tile"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/w_ink" android:textSize="26sp" android:textStyle="bold" android:textDirection="ltr" android:gravity="start"/>
            <TextView android:id="@+id/w_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end"
                android:textColor="@color/w_soft" android:textSize="12sp"/>
        </LinearLayout>
        <ImageView android:id="@+id/w_ring" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="10dp" android:contentDescription="@null"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/w_cta" android:layout_width="wrap_content" android:layout_height="34dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center"
            android:background="@drawable/w_bg_cta" android:textColor="@color/w_on_cta" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:gravity="end"
            android:singleLine="true" android:textColor="@color/w_faint" android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
