<?xml version="1.0" encoding="utf-8"?>
<!-- Production : HTTPS uniquement (aucun trafic en clair). La variante debug autorise
     l'API locale (émulateur 10.0.2.2 / localhost / LAN) — voir src/debug/res/xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
