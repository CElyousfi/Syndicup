<?xml version="1.0" encoding="utf-8"?>
<!-- App Actions (Assistant Google) : « Ok Google, payer mes charges avec SyndicUp ». Les raccourcis
     dynamiques (appui long sur l'icône) restent gérés par l'app (quick_actions). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent android:action="android.intent.action.VIEW" android:data="syndicup:///tableau-de-bord">
            <parameter android:name="feature" android:key="feature"/>
        </intent>
    </capability>
    <shortcut android:shortcutId="payer" android:enabled="true" android:icon="@drawable/ic_quick_payer" android:shortcutShortLabel="@string/sc_payer" android:shortcutLongLabel="@string/sc_payer">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="ma.syndicup.app" android:targetClass="ma.syndicup.app.MainActivity" android:data="syndicup:///payer"/>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/sc_payer_synonymes"/>
        </capability-binding>
    </shortcut>
    <shortcut android:shortcutId="signaler" android:enabled="true" android:icon="@drawable/ic_quick_signaler" android:shortcutShortLabel="@string/sc_signaler" android:shortcutLongLabel="@string/sc_signaler">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="ma.syndicup.app" android:targetClass="ma.syndicup.app.MainActivity" android:data="syndicup:///incidents/nouveau"/>
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding android:key="feature" android:value="@array/sc_signaler_synonymes"/>
        </capability-binding>
    </shortcut>
</shortcuts>
