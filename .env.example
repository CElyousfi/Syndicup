# ══════════════════════════════════════════════════════════════════════════
# Variables d'environnement — copropriete-maroc
# Aucun secret réel dans ce fichier (Master Spec Partie 10.3). Copier en .env.local par appli
# (apps/api/.env.local, apps/web/.env.local). En staging / production les valeurs vivent dans le
# tableau de bord Render (render.yaml : `sync: false`) — voir docs/DEPLOYMENT.md pour le tableau
# complet (obligatoire ou non, où obtenir chaque valeur). L'API valide TOUT au démarrage
# (apps/api/lib/config/env.ts) : une variable manquante ou mal formée empêche le serveur de démarrer.
# ══════════════════════════════════════════════════════════════════════════

# ── Supabase (Postgres + Auth + Storage + Realtime — Master Spec Partie 1.2) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Utilisée par Prisma (packages/database) — pooler Supabase recommandé pour les fonctions Vercel
DATABASE_URL=
# Connexion directe (migrations uniquement, hors pooler)
DIRECT_URL=

# ── Auth (Master Spec Partie 4) ──────────────────────────────────────────────
JWT_SECRET=
# Utilisé par le middleware pour signer/vérifier au besoin en complément du JWT Supabase

# ── CMI — paiement (Master Spec Partie 6.4, 1.8) ─────────────────────────────
# NON UTILISÉ AU LANCEMENT : toutes ces variables sont optionnelles ; tant que
# CMI_WEBHOOK_HMAC_SECRET est absent, POST /finances/paiements/cmi/{initier,webhook} répondent
# 501 NOT_IMPLEMENTED. Compte marchand à ouvrir séparément (docs/ROADMAP_BACKLOG.md M0).
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_API_URL=
CMI_WEBHOOK_HMAC_SECRET=

# ── SMS Maroc (Master Spec Partie 7, 1.8) ────────────────────────────────────
# Agrégateur non encore choisi (Vonage/Twilio route Maroc ou opérateur local) — variables à
# adapter une fois le fournisseur contractualisé. Construire M2/M9 (ROADMAP_BACKLOG) contre un
# sandbox/mock en attendant, ne pas bloquer le code sur ce choix.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ── Firebase Cloud Messaging — push (Master Spec Partie 7, 13.4) ─────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# ^ contenu JSON du service account, stocké comme secret unique (pas un fichier commité)

# ── Resend — email transactionnel (Master Spec Partie 1.2, 1.8) ─────────────
RESEND_API_KEY=
# Adresse d'expédition (ex. "SyndicUp <notifications@syndicup.ma>"). Le code lit RESEND_FROM ;
# l'ancien nom RESEND_FROM_EMAIL reste accepté UNE version avec un avertissement dans les logs.
RESEND_FROM=
# Domaine à réserver tôt + SPF/DKIM/DMARC configurés avant tout test de délivrabilité

# ── Inngest — jobs asynchrones/cron (Master Spec Partie 1.2, 15.3) ──────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Monitoring (Master Spec Partie 1.2, 15.4) ────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=
BETTERSTACK_API_KEY=

# ── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# Base de l'API vue par le web, préfixe /v1 inclus. Repli http://localhost:3001/v1 en
# développement UNIQUEMENT : obligatoire en staging / production (le web refuse de démarrer sinon).
API_BASE_URL=https://api.copropriete-maroc.ma/v1
NODE_ENV=development
# Environnement applicatif : development | staging | production (Sentry, garde-fous de prod :
# Upstash obligatoire, INNGEST_DEV interdit…). Repli sur NODE_ENV s'il est absent — attention,
# `next start` force NODE_ENV=production : poser APP_ENV=development pour lancer une build en local.
# Obligatoire en production. Remplace l'ancien VERCEL_ENV.
APP_ENV=development
# Render : PORT est fourni par la plateforme (`next start -p $PORT`) et RENDER_GIT_COMMIT est
# exposé par GET /api/health — rien à renseigner.
# PORT=
# RENDER_GIT_COMMIT=

# ── CNDP (Master Spec Partie 10.1, docs/LEGAL_QUESTIONS_BRIEF.md §6) ────────
# Pas une variable technique — rappel que la déclaration préalable du traitement doit être
# déposée sur portail.cndp.ma avant l'ouverture publique. Aucune clé API associée à ce jour.

# ── Rate limiting applicatif (lib/rate-limit — M12, M0) ──────────────────────
# Upstash Redis (REST) : compteurs partagés entre instances. Créer une base « Regional » à
# Francfort sur console.upstash.com → onglet REST → copier URL et token (lecture/écriture).
# Sans ces deux variables : limiteur MÉMOIRE par instance en development / staging (dégradation
# sûre) ; en production (APP_ENV=production) l'API REFUSE DE DÉMARRER.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Plafonds techniques surchargables (défauts : 5 OTP/h, 10 auth/15min, 30 écritures fin./min,
# 120 webhooks CMI/min) :
# RATE_LIMIT_OTP_REQUEST_MAX=5
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_FINANCE_MAX=30
# RATE_LIMIT_CMI_WEBHOOK_MAX=120

# ── Transports de notification (lib/notifications/transports — M12) ──────────
# Sans configuration : transport noop, statut EN_ATTENTE honnête (rien n'est envoyé).
#
# EMAIL — deux options (priorité à Resend si les deux sont posées) :
#   1) API Resend :        RESEND_API_KEY= + RESEND_FROM=notifications@votre-domaine.ma
#   2) SMTP (nodemailer) : SMTP_URL=smtp://user:pass@hote:port + EMAIL_FROM="SyndicUp <...>"
#      · local  : SMTP_URL=smtp://127.0.0.1:54325 → Inbucket Supabase (http://127.0.0.1:54324)
#      · prod   : SMTP transactionnel (smtp.resend.com:465, SES, Infomaniak…)
# SMTP_URL=
# EMAIL_FROM=
#
# SMS — SMS_PROVIDER sélectionne l'adaptateur (lib/notifications/transports/sms.ts) :
#   twilio  : SMS_API_KEY=<Account SID> SMS_API_SECRET=<Auth Token> SMS_SENDER_ID=<From E.164>
#   generic : SMS_API_URL=<endpoint agrégateur marocain> SMS_API_KEY=<clé> [SMS_SENDER_ID=]
#             (POST JSON { to, body, sender } — format à ajuster au contrat, un seul fichier)
#   dev     : livraison locale réelle dans Inbucket (sms+<numero>@sms.local) via SMTP_URL
# SMS_PROVIDER=
# SMS_API_SECRET=
#
# FCM_SERVICE_ACCOUNT_JSON=   # JSON du service account Firebase (push mobile M19 — API HTTP v1,
#                             # jetons d'appareils via POST /users/me/appareils)
# SMS_API_URL=
# SMS_API_KEY=

# ── Inngest (jobs asynchrones — M12) ─────────────────────────────────────────
# Local : INNGEST_DEV=1 + `npx inngest-cli@latest dev -u http://localhost:3001/api/inngest`.
# Production (M0) :
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
INNGEST_DEV=1
